# Base URL for the backend API.
# Leave as /api in production (served behind the same origin via nginx).
# For local dev against a separate backend port, use http://localhost:7777/api
VITE_API_BASE_URL=/api

# TURN relay for video calls across different networks (NAT traversal).
# STUN alone (built in) works only when at least one peer has a friendly NAT;
# for reliable cross-internet calls you need TURN. Get free credentials from
# https://dashboard.metered.ca or https://www.expressturn.com and paste below.
# Comma-separate multiple URLs. Leave blank to use STUN only.
# VITE_TURN_URLS=turn:your-turn-host:80,turn:your-turn-host:443,turns:your-turn-host:443?transport=tcp
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
