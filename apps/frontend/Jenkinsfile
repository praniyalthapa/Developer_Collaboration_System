        stage('Deploy') {
            steps {
                sh """
                    docker pull ${IMAGE_NAME}:${BUILD_NUMBER}

                    docker rm -f frontend-preview-old 2>/dev/null || true

                    docker rename frontend-preview frontend-preview-old 2>/dev/null || true

                    docker run -d \\
                      -p 8081:80 \\
                      --name frontend-preview \\
                      ${IMAGE_NAME}:${BUILD_NUMBER}

                    sleep 5

                    curl -f http://localhost:8081 || (
                        echo "Health check failed, rolling back"
                        docker rm -f frontend-preview
                        docker rename frontend-preview-old frontend-preview 2>/dev/null || true
                        exit 1
                    )

                    echo "Deployment successful"
                    docker rm -f frontend-preview-old 2>/dev/null || true
                """
            }
        }
    }
}
