pipeline {
    agent any

    environment {
        IMAGE_NAME = "praniyalthapa/devcollab-frontend"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'refactor',
                    url: 'https://github.com/praniyalthapa/Developer_Collaboration_System.git'
            }
        }

        stage('Set Version Vars') {
            steps {
                script {
                    env.GIT_SHA = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                }
                echo "Building commit: ${env.GIT_SHA}"
            }
        }

        // ---- BUILD ONCE ----
        stage('Build Image') {
            steps {
                sh """
                    docker build \\
                      --build-arg VITE_API_BASE_URL=/api \\
                      -t ${IMAGE_NAME}:${GIT_SHA} \\
                      apps/frontend
                """
            }
        }

        // ---- PUSH THE ONE IMMUTABLE TAG ----
        stage('Push Immutable Tag') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${GIT_SHA}
                        docker logout
                    """
                }
            }
        }

        // ---- RETAG (NOT REBUILD) AS dev, PUSH THE POINTER ----
        stage('Promote: Dev') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker tag ${IMAGE_NAME}:${GIT_SHA} ${IMAGE_NAME}:dev
                        docker push ${IMAGE_NAME}:dev
                        docker logout
                    """
                }
            }
        }

        // ---- DEPLOY dev, WITH ROLLBACK ON FAILED HEALTH CHECK ----
        stage('Deploy: Dev') {
            steps {
                sh """
                    docker pull ${IMAGE_NAME}:dev

                    docker rm -f frontend-dev-old 2>/dev/null || true
                    docker rename frontend-dev frontend-dev-old 2>/dev/null || true

                    docker run -d \\
                      -p 8081:80 \\
                      --name frontend-dev \\
                      ${IMAGE_NAME}:dev || (
                        echo "Run failed, rolling back"
                        docker rename frontend-dev-old frontend-dev 2>/dev/null || true
                        exit 1
                    )

                    sleep 5

                    curl -f http://localhost:8081 || (
                        echo "Health check failed, rolling back"
                        docker rm -f frontend-dev
                        docker rename frontend-dev-old frontend-dev 2>/dev/null || true
                        exit 1
                    )

                    echo "Deployment to dev successful: ${GIT_SHA}"
                    docker rm -f frontend-dev-old 2>/dev/null || true
                """
            }
        }

        // ---- WRITE THE NEW IMAGE TAG INTO deployment.yaml AND PUSH TO GITHUB ----
        stage('Update Manifest') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-creds',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        REPO="https://${GIT_USER}:${GIT_TOKEN}@github.com/praniyalthapa/Developer_Collaboration_System.git"
                        FILE="apps/frontend/deploy/deployment.yaml"

                        git config user.email "jenkins@local"
                        git config user.name "jenkins"
                        git checkout -B refactor

                        sed -i "s|image: .*|image: ${IMAGE_NAME}:${GIT_SHA}|" "$FILE"

                        git add "$FILE"
                        if git diff --cached --quiet; then
                            echo "Manifest already up to date"
                            exit 0
                        fi

                        git commit -m "ci: update frontend image to ${GIT_SHA} [skip ci]"
                        git pull --rebase "$REPO" refactor
                        git push "$REPO" HEAD:refactor
                    '''
                }
            }
        }
    }

    post {
        always {
            sh "docker image prune -f"
        }
    }
}
