pipeline {
    agent any

    environment {
        IMAGE_NAME = "praniyalthapa/devcollab-frontend"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'refactor',
                    url: 'https://github.com/praniyalthapa/Developer_Collaboration_System.git'
            }
        }

        stage('Set Version Vars') {
            steps {
                script {
                    env.GIT_SHA = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                }
                echo "Building commit: ${env.GIT_SHA}"
            }
        }

        stage('SAST - SonarQube') {
            steps {
                dir('apps/frontend') {
                    withSonarQubeEnv('MySonarQube') {
                        script {
                            def scannerHome = tool 'SonarScanner'
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ---- BUILD ONCE ----
        stage('Build Image') {
            steps {
                sh """
                    docker build \\
                      --build-arg VITE_API_BASE_URL=/api \\
                      -t ${IMAGE_NAME}:${GIT_SHA} \\
                      apps/frontend
                """
            }
        }

        // ---- PUSH THE ONE IMMUTABLE TAG ----
        stage('Push Immutable Tag') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${GIT_SHA}
                        docker logout
                    """
                }
            }
        }

        // ---- RETAG (NOT REBUILD) AS dev, PUSH THE POINTER ----
        stage('Promote: Dev') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker tag ${IMAGE_NAME}:${GIT_SHA} ${IMAGE_NAME}:dev
                        docker push ${IMAGE_NAME}:dev
                        docker logout
                    """
                }
            }
        }

        // ---- DEPLOY dev, WITH ROLLBACK ON FAILED HEALTH CHECK ----
        stage('Deploy: Dev') {
            steps {
                sh """
                    docker pull ${IMAGE_NAME}:dev

                    docker rm -f frontend-dev-old 2>/dev/null || true
                    docker rename frontend-dev frontend-dev-old 2>/dev/null || true

                    docker run -d \\
                      -p 8081:80 \\
                      --name frontend-dev \\
                      ${IMAGE_NAME}:dev || (
                        echo "Run failed, rolling back"
                        docker rename frontend-dev-old frontend-dev 2>/dev/null || true
                        exit 1
                    )

                    sleep 5

                    curl -f http://localhost:8081 || (
                        echo "Health check failed, rolling back"
                        docker rm -f frontend-dev
                        docker rename frontend-dev-old frontend-dev 2>/dev/null || true
                        exit 1
                    )

                    echo "Deployment to dev successful: ${GIT_SHA}"
                    docker rm -f frontend-dev-old 2>/dev/null || true
                """
            }
        }
    }

    post {
        always {
            sh "docker image prune -f"
        }
    }
}
