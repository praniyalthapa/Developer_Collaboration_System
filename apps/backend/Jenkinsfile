pipeline {
    agent any

    environment {
        IMAGE_NAME = "praniyalthapa/devcollab-backend"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'refactor',
                    url: 'https://github.com/praniyalthapa/Developer_Collaboration_System.git'
            }
        }

        stage('Install & Test') {
            steps {
                dir('apps/backend') {
                    sh '''
                        npm ci
                        npm run lint
                        npm run typecheck
                        npm run test
                    '''
                }
            }
        }

        stage('SAST - SonarQube') {
            steps {
                dir('apps/backend') {
                    withSonarQubeEnv('MySonarQube') {
                        script {
                            def scannerHome = tool 'SonarScanner'
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Build Image') {
            steps {
                sh """
                    docker build \\
                      -t ${IMAGE_NAME}:${BUILD_NUMBER} \\
                      -t ${IMAGE_NAME}:latest \\
                      apps/backend
                """
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                        docker push ${IMAGE_NAME}:latest
                        docker logout
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    string(credentialsId: 'backend-jwt-secret', variable: 'JWT_SECRET'),
                    string(credentialsId: 'backend-mongo-uri',  variable: 'MONGO_URI')
                ]) {
                    sh """
                        docker pull ${IMAGE_NAME}:${BUILD_NUMBER}

                        docker rm -f backend-preview-old 2>/dev/null || true
                        docker rename backend-preview backend-preview-old 2>/dev/null || true

                        docker run -d \\
                          -p 7777:7777 \\
                          -e PORT=7777 \\
                          -e HOST=0.0.0.0 \\
                          -e NODE_ENV=production \\
                          -e MONGO_URI="\$MONGO_URI" \\
                          -e JWT_SECRET="\$JWT_SECRET" \\
                          -e RUN_SEED=false \\
                          -e CORS_ORIGIN=http://localhost:5173 \\
                          --name backend-preview \\
                          ${IMAGE_NAME}:${BUILD_NUMBER}

                        sleep 8

                        curl -s -o /dev/null -w "%{http_code}" http://localhost:7777/ | grep -qE "^(2|3|401)" || (
                            echo "Health check failed, rolling back"
                            docker logs backend-preview
                            docker rm -f backend-preview
                            docker rename backend-preview-old backend-preview 2>/dev/null || true
                            exit 1
                        )

                        echo "Deployment successful"
                        docker rm -f backend-preview-old 2>/dev/null || true
                    """
                }
            }
        }
    }
}
