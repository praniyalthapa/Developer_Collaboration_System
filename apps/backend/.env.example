# Server
PORT=7777
HOST=0.0.0.0
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27018/devcollab

# Auth (REQUIRED - the server refuses to start without a strong secret)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# CORS / URLs
CORS_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:7777

# Seeding (creates the admin + demo accounts on startup)
RUN_SEED=true

# Code execution for the pair-programming "Run" button.
# Runs user code in the language runtimes installed on the server
# (node, python3, java, go, tsx) with a 10s timeout. JavaScript runs in a
# sandboxed browser worker instead. SECURITY: this executes untrusted code
# on the host; run the backend in an isolated container in production, or
# set this to false to disable server-side execution.
CODE_EXECUTION_ENABLED=true

# Google OAuth (optional - OAuth routes are disabled if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Email (optional - emails are logged to console if unset)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DevCollab <no-reply@devcollab.dev>"

# Payments (optional - payment routes are disabled if unset)
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
