{
  "name": "devcollab-system",
  "version": "2.0.0",
  "private": true,
  "description": "Developer Collaboration System - TypeScript monorepo",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:backend dev:frontend",
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "build": "npm-run-all build:backend build:frontend",
    "build:backend": "npm --prefix apps/backend run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "typecheck": "npm-run-all typecheck:backend typecheck:frontend",
    "typecheck:backend": "npm --prefix apps/backend run typecheck",
    "typecheck:frontend": "npm --prefix apps/frontend run typecheck",
    "lint": "npm-run-all lint:backend lint:frontend",
    "lint:backend": "npm --prefix apps/backend run lint",
    "lint:frontend": "npm --prefix apps/frontend run lint",
    "seed": "npm --prefix apps/backend run seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
